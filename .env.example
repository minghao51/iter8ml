# ============================================================================
# iter8ml environment variables
# Copy this file to `.env` and fill in values. All variables are OPTIONAL —
# the framework runs end-to-end with none of them set. Grouped by purpose.
# ============================================================================

# ---------------------------------------------------------------------------
# Foundation models — licensing
# ---------------------------------------------------------------------------
# TabPFN license token (required for TabPFN in CI / headless environments).
# Get yours at https://ux.priorlabs.ai → License tab
TABPFN_TOKEN=

# ---------------------------------------------------------------------------
# LLM commentary (optional) — natural-language explanations of model results
# via LiteLLM. Off by default; enable with ExperimentConfig(..., llm_enabled=True).
# Default model: claude-sonnet-4-20250514. Override with ITER8ML_LLM_MODEL.
# The provider key variable is configurable (LLMAgentConfig.api_key_env);
# LiteLLM reads these standard provider names automatically.
# ---------------------------------------------------------------------------
ITER8ML_LLM_MODEL=
# Legacy alias (old project name): TABBLUEPRINT_LLM_MODEL — still read as a fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Experiment tracking (optional) — mirror events to W&B or a remote MLflow server
# ---------------------------------------------------------------------------
WANDB_API_KEY=
MLFLOW_TRACKING_URI=

# ---------------------------------------------------------------------------
# Runtime (usually auto-managed — override only to debug)
# ---------------------------------------------------------------------------
# OpenMP thread cap. Auto-set to 8 on Linux to avoid the libgomp deadlock on
# hybrid-core (P+E) CPUs under WSL2/Linux (Phase-1 issue 1.6b).
OMP_NUM_THREADS=
# Override the workspace root (default: ./workspace)
ITER8ML_WORKSPACE=

# ---------------------------------------------------------------------------
# Deploy — Phase 2 live demo (Gradio on HF Spaces)
# ---------------------------------------------------------------------------
# Hugging Face access token (write scope) to push the demo Space.
# Create at https://huggingface.co/settings/tokens
# For automated CI deploys, store this as a GitHub Actions secret instead.
HF_TOKEN=
